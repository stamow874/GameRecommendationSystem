
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GameFinder</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GameRecommendationSystem.styles.css" asp-append-version="true" />
</head>

<body class="gf-body">

    <div class="gf-app">

        <!-- SIDEBAR -->
        <aside class="gf-sidebar">

            <a class="gf-logo" asp-controller="Home" asp-action="Index">
                <span class="gf-logo-icon">G</span>
                <span>GameFinder</span>
            </a>

            <div class="gf-section-label">МОЯТА БИБЛИОТЕКА</div>

            <nav class="gf-main-buttons">

                <a class="gf-main-button"
                   asp-controller="Favorites"
                   asp-action="Index">
                    <span class="gf-button-icon">♥</span>
                    <span>Любими игри</span>
                    <span class="gf-arrow">›</span>
                </a>

                <a class="gf-main-button"
                   asp-controller="Library"
                   asp-action="RecentlyPlayed">
                    <span class="gf-button-icon">◷</span>
                    <span>Скоро играни</span>
                    <span class="gf-arrow">›</span>
                </a>

                <a class="gf-main-button"
                   asp-controller="Library"
                   asp-action="Index">
                    <span class="gf-button-icon">▦</span>
                    <span>Моята библиотека</span>
                    <span class="gf-arrow">›</span>
                </a>

            </nav>

            <div class="gf-divider"></div>

            <div class="gf-section-label">НАВИГАЦИЯ</div>

            <nav class="gf-navigation">

                <a class="gf-nav-link" asp-controller="Home" asp-action="Index">
                    <span class="gf-nav-icon">⌂</span>
                    <span>Начало</span>
                </a>

                <a class="gf-nav-link" asp-controller="Games" asp-action="Index">
                    <span class="gf-nav-icon">✧</span>
                    <span>Игри</span>
                </a>

                <a class="gf-nav-link" asp-controller="Genres" asp-action="Index">
                    <span class="gf-nav-icon">◈</span>
                    <span>Жанрове</span>
                </a>

                <a class="gf-nav-link" asp-controller="Platforms" asp-action="Index">
                    <span class="gf-nav-icon">▣</span>
                    <span>Платформи</span>
                </a>

                <a class="gf-nav-link" asp-controller="Publishers" asp-action="Index">
                    <span class="gf-nav-icon">◆</span>
                    <span>Издатели</span>
                </a>

            </nav>

            <div class="gf-sidebar-bottom">

                <div class="gf-steam-card">
                    <div class="gf-steam-icon">◉</div>

                    <h3>Свържи Steam</h3>

                    <p>
                        Свържи своя акаунт и получи
                        персонализирани препоръки.
                    </p>

                    <button type="button" disabled>
                        Очаквай скоро
                    </button>
                </div>

                <div class="gf-sidebar-footer">
                    GAMEFINDER © @DateTime.Now.Year
                </div>

            </div>

        </aside>


        <!-- MAIN CONTENT -->
        <div class="gf-main">

            <header class="gf-topbar">

                <form class="gf-search"
                      asp-controller="Games"
                      asp-action="Index"
                      method="get">

                    <span class="gf-search-icon">⌕</span>

                    <input type="search"
                           name="searchString"
                           placeholder="Търси игри, жанрове..."
                           aria-label="Търси игри" />

                    <button type="submit">Търси</button>

                </form>

                <div class="gf-account">
                    <partial name="_LoginPartial" />
                </div>

            </header>

            <main class="gf-content">
                @RenderBody()
            </main>

            <footer class="gf-footer">
                Персонализирани препоръки за видеоигри.
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
