@model GameRecommendationSystem.Data.ApplicationUser

@{
    ViewData["Title"] = "Свързване със Steam";
    var isConnected = !string.IsNullOrWhiteSpace(Model.SteamId);
}

<div class="steam-page">
    <div class="steam-container">
        <div class="steam-header">
            <div class="steam-icon">◉</div>
            <h1>Свързване със Steam</h1>
            <p>Свържи своя Steam профил с Хрумка и получи персонализирани препоръки според игрите в библиотеката си.</p>
        </div>

        <div id="steam-popup-message" class="steam-message" hidden></div>

        @if (isConnected)
        {
            <div class="steam-profile">
                <div class="steam-profile-header">
                    @if (!string.IsNullOrWhiteSpace(Model.SteamAvatarUrl))
                    {
                        <img src="@Model.SteamAvatarUrl" alt="Steam аватар" class="steam-avatar" />
                    }
                    else
                    {
                        <div class="steam-avatar-placeholder">S</div>
                    }

                    <div class="steam-profile-info">
                        <h2>@(Model.SteamDisplayName ?? "Steam потребител")</h2>
                        <span class="steam-status">Свързан профил</span>
                    </div>
                </div>

                <div class="steam-details">
                    <div class="steam-detail">
                        <span>Steam ID</span>
                        <strong>@Model.SteamId</strong>
                    </div>

                    <div class="steam-detail">
                        <span>Дата на свързване</span>
                        <strong>@(Model.SteamConnectedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Няма информация")</strong>
                    </div>

                    <div class="steam-detail">
                        <span>Последна синхронизация</span>
                        <strong>@(Model.SteamLastSyncedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Все още няма синхронизация")</strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.SteamProfileUrl))
                {
                    <a href="@Model.SteamProfileUrl" target="_blank" rel="noopener noreferrer" class="steam-profile-link">
                        Отвори Steam профила
                    </a>
                }

                <div class="steam-actions">
                    <form asp-controller="Steam" asp-action="Sync" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="steam-button steam-sync-button">
                            Синхронизирай библиотеката
                        </button>
                    </form>

                    <form asp-controller="Steam" asp-action="Disconnect" method="post" id="steam-disconnect-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="steam-button steam-disconnect-button">
                            Излез от Steam профила
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="steam-connect-card">
                <h2>Все още нямаш свързан Steam профил</h2>
                <p>Свържи своя профил, за да може Хрумка да зареди игрите от твоята Steam библиотека.</p>

                <button type="button" id="steam-connect-button" class="steam-button steam-connect-button">
                    Свържи Steam профил
                </button>

                <div class="steam-information">
                    <p>След свързването ще можеш да синхронизираш библиотеката си и да получаваш препоръки.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .steam-page {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 45px 20px;
        color: #fff;
    }

    .steam-container {
        width: 100%;
        max-width: 760px;
        padding: 35px;
        background: #171b2b;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0,0,0,.25);
    }

    .steam-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .steam-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #253b5b;
        color: #66c0f4;
        font-size: 35px;
    }

    .steam-header h1 {
        font-size: 30px;
        margin-bottom: 12px;
        color: #fff;
    }

    .steam-header p,
    .steam-connect-card p {
        color: #aeb8ca;
        line-height: 1.7;
    }

    .steam-profile,
    .steam-connect-card {
        padding: 25px;
        background: #20263a;
        border-radius: 14px;
    }

    .steam-profile-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 25px;
    }

    .steam-avatar,
    .steam-avatar-placeholder {
        width: 75px;
        height: 75px;
        border-radius: 12px;
        object-fit: cover;
    }

    .steam-avatar-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #253b5b;
        color: #66c0f4;
        font-size: 32px;
        font-weight: bold;
    }

    .steam-profile-info h2 {
        margin: 0 0 8px;
        color: #fff;
        font-size: 22px;
    }

    .steam-status {
        color: #69d69a;
        font-size: 14px;
    }

    .steam-details {
        display: grid;
        gap: 14px;
        margin-bottom: 20px;
    }

    .steam-detail {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: 12px 15px;
        background: #171b2b;
        border-radius: 9px;
        overflow-wrap: anywhere;
    }

        .steam-detail span {
            color: #9da9bd;
            font-size: 13px;
        }

        .steam-detail strong {
            color: #fff;
            font-size: 14px;
        }

    .steam-profile-link {
        display: inline-block;
        margin-bottom: 22px;
        color: #66c0f4;
        text-decoration: none;
    }

        .steam-profile-link:hover {
            color: #91d4ff;
            text-decoration: underline;
        }

    .steam-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

        .steam-actions form {
            width: 100%;
        }

    .steam-button {
        width: 100%;
        min-height: 48px;
        padding: 12px 18px;
        border: none;
        border-radius: 9px;
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s ease;
    }

    .steam-connect-button,
    .steam-sync-button {
        background: #176b9b;
    }

        .steam-connect-button:hover,
        .steam-sync-button:hover {
            background: #2188bd;
        }

    .steam-disconnect-button {
        background: #9b3545;
    }

        .steam-disconnect-button:hover {
            background: #bd4053;
        }

    .steam-connect-card {
        text-align: center;
    }

        .steam-connect-card h2 {
            color: #fff;
            font-size: 22px;
            margin-bottom: 12px;
        }

        .steam-connect-card p {
            margin-bottom: 22px;
        }

    .steam-information {
        margin-top: 20px;
        padding: 15px;
        background: #171b2b;
        border-radius: 9px;
    }

        .steam-information p {
            margin: 0;
            font-size: 13px;
        }

    .steam-message {
        margin-bottom: 20px;
        padding: 14px;
        border-radius: 9px;
        line-height: 1.5;
    }

    .steam-success {
        background: rgba(46, 160, 95, .15);
        border: 1px solid #2ea05f;
        color: #80e0a7;
    }

    .steam-error {
        background: rgba(190, 55, 70, .15);
        border: 1px solid #be3746;
        color: #ff9ca6;
    }

    @@media (max-width: 600px) {
        .steam-page {
            padding: 20px 10px;
        }

        .steam-container {
            padding: 20px 15px;
        }

        .steam-header h1 {
            font-size: 24px;
        }

        .steam-profile,
        .steam-connect-card {
            padding: 18px;
        }
    }
</style>

<script>
    
    (() => {
        const steamConnectButton = document.getElementById("steam-connect-button");
        const steamPopupMessage = document.getElementById("steam-popup-message");
        const steamConnectUrl = '@Url.Action("Connect", "Steam", new { popup = true })';

        if (steamConnectButton) {
            steamConnectButton.addEventListener("click", function () {
                const popup = window.open(
                    steamConnectUrl,
                    "_blank",
                    "width=800,height=700"
                );

                if (!popup && steamPopupMessage) {
                    steamPopupMessage.hidden = false;
                    steamPopupMessage.textContent = "Браузърът блокира изскачащия прозорец. Разреши изскачащите прозорци за Хрумка и опитай отново.";
                    steamPopupMessage.className = "steam-message steam-error";
                }
            });
        }

        window.addEventListener("message", function (event) {
            if (event.origin !== window.location.origin) {
                return;
            }

            const data = event.data;

            if (!data || data.type !== "hrumka-steam") {
                return;
            }

            if (steamPopupMessage) {
                steamPopupMessage.hidden = false;
                steamPopupMessage.textContent = data.message;
                steamPopupMessage.className = data.success
                    ? "steam-message steam-success"
                    : "steam-message steam-error";
            }

            if (data.success) {
                window.setTimeout(function () {
                    window.location.reload();
                }, 1000);
            }
        });

        const disconnectForm = document.getElementById("steam-disconnect-form");

        if (disconnectForm) {
            disconnectForm.addEventListener("submit", function (event) {
                const confirmed = window.confirm(
                    "Сигурен ли си, че искаш да излезеш от Steam профила? Steam връзката и синхронизираните игри ще бъдат премахнати от Хрумка."
                );

                if (!confirmed) {
                    event.preventDefault();
                }
            });
        }
    })();

</script>
