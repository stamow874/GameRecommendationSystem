@model List<GameRecommendationSystem.Models.UserSteamGame>

@{
    ViewData["Title"] = "Моята библиотека";
}

<div class="library-page">
    <div class="library-header">
        <div>
            <span class="library-label">ТВОИТЕ ИГРИ</span>
            <h1>Моята библиотека</h1>
            <p>Всички игри от твоята Steam библиотека на едно място.</p>
        </div>

        <div class="library-count">
            <span>@Model.Count</span>
            <small>игри</small>
        </div>
    </div>

    @if (Model.Count > 0)
    {
        <div class="library-summary">
            <div>
                <span>Общо игри</span>
                <strong>@Model.Count</strong>
            </div>
            <div>
                <span>Общо изиграно време</span>
                <strong>@(Model.Sum(x => x.PlaytimeForeverMinutes) / 60) часа</strong>
            </div>
        </div>

        <div class="library-grid">
            @foreach (var game in Model)
            {
                <div class="library-game-card">
                    <div class="game-image">
                        @if (!string.IsNullOrWhiteSpace(game.IconUrl))
                        {
                            <img src="https://cdn.cloudflare.steamstatic.com/steam/apps/@game.AppId/header.jpg"
                                 alt="@game.Name"
                                 onerror="this.onerror=null;this.src='@game.IconUrl';" />
                        }
                        else
                        {
                            <div class="game-placeholder">🎮</div>
                        }
                    </div>

                    <div class="game-information">
                        <h3>@game.Name</h3>

                        <div class="game-playtime">
                            <span>Изиграно време</span>
                            <strong>
                                @(game.PlaytimeForeverMinutes / 60) ч.
                                @(game.PlaytimeForeverMinutes % 60) мин.
                            </strong>
                        </div>

                        @if (game.PlaytimeTwoWeeksMinutes.HasValue)
                        {
                            <div class="game-recent-playtime">
                                Последните 2 седмици:
                                <strong>@(game.PlaytimeTwoWeeksMinutes.Value / 60) ч.</strong>
                            </div>
                        }

                        @if (game.LastPlayedAt.HasValue)
                        {
                            <div class="game-last-played">
                                Последно играна:
                                @game.LastPlayedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")
                            </div>
                        }
                        else
                        {
                            <div class="game-last-played">
                                Все още няма записана игра
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="library-empty">
            <div class="empty-icon">🎮</div>
            <h2>Библиотеката ти е празна</h2>
            <p>Все още няма синхронизирани игри. Свържи Steam профила си и синхронизирай библиотеката.</p>
            <a asp-controller="Steam" asp-action="Index">Към Steam настройките</a>
        </div>
    }
</div>

<style>
    .library-page {
        padding: 35px;
        color: #fff;
    }

    .library-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .library-label {
        color: #a78bfa;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .library-header h1 {
        font-size: 30px;
        font-weight: 700;
        margin: 8px 0;
    }

    .library-header p {
        color: #a5a6b5;
        margin: 0;
    }

    .library-count {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 85px;
        height: 85px;
        background: #202235;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 15px;
    }

        .library-count span {
            font-size: 25px;
            font-weight: 700;
            color: #a78bfa;
        }

        .library-count small {
            color: #a5a6b5;
        }

    .library-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 25px;
    }

        .library-summary div {
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 20px;
            background: #202235;
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 12px;
        }

        .library-summary span {
            color: #a5a6b5;
            font-size: 13px;
        }

        .library-summary strong {
            font-size: 22px;
            color: #fff;
        }

    .library-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 18px;
    }

    .library-game-card {
        overflow: hidden;
        background: #171827;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 13px;
        transition: transform .2s, border-color .2s;
    }

        .library-game-card:hover {
            transform: translateY(-4px);
            border-color: rgba(167,139,250,.5);
        }

    .game-image {
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #202235;
        overflow: hidden;
    }

        .game-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .game-placeholder {
        font-size: 35px;
    }

    .game-information {
        padding: 17px;
    }

        .game-information h3 {
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 15px;
            min-height: 38px;
        }

    .game-playtime {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 0;
        border-top: 1px solid rgba(255,255,255,.07);
        border-bottom: 1px solid rgba(255,255,255,.07);
    }

        .game-playtime span,
        .game-recent-playtime,
        .game-last-played {
            color: #a5a6b5;
            font-size: 12px;
        }

            .game-playtime strong,
            .game-recent-playtime strong {
                color: #a78bfa;
            }

    .game-recent-playtime,
    .game-last-played {
        margin-top: 10px;
    }

    .library-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 65px 25px;
        background: #171827;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 15px;
    }

    .empty-icon {
        font-size: 55px;
        margin-bottom: 15px;
    }

    .library-empty h2 {
        font-size: 22px;
        margin-bottom: 10px;
    }

    .library-empty p {
        max-width: 480px;
        color: #a5a6b5;
        line-height: 1.7;
        margin-bottom: 22px;
    }

    .library-empty a {
        padding: 13px 22px;
        background: #6554c0;
        color: #fff;
        text-decoration: none;
        border-radius: 9px;
        font-weight: 600;
        transition: .2s;
    }

        .library-empty a:hover {
            background: #7968d8;
            color: #fff;
        }

    @@media (max-width: 700px) {
        .library-page {
            padding: 20px;
        }

        .library-header h1 {
            font-size: 24px;
        }

        .library-summary {
            grid-template-columns: 1fr;
        }

        .library-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
